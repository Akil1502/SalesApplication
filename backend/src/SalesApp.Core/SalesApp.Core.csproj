<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain entities, DTOs and pure business logic. No EF Core, no ASP.NET Core. -->
  <ItemGroup>
    <!-- Only for IdentityUser<TKey>, which AppUser derives from. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tamil for text the server writes, keyed by the English (see Localization/L.cs). -->
    <EmbeddedResource Include="Localization/ta.json" LogicalName="SalesApp.Core.Localization.ta.json" />
  </ItemGroup>

</Project>
