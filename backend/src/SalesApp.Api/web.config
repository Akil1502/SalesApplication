<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings. `dotnet publish` fills in the ASP.NET Core handler; see docs/DEPLOYMENT-IIS.md. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Ask your data and the assistant stream their progress as server-sent events, which IIS's dynamic
           compression would hold back until the reply ends. The built web app's files are still compressed. -->
      <urlCompression doStaticCompression="true" doDynamicCompression="false" />
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SalesApp.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
