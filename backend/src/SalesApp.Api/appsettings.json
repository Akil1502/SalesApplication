{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "SalesApp",
    "Audience": "SalesApp.Web",
    "LifetimeMinutes": 480,
    "SigningKey": ""
  },
  "Seed": {
    "AdminEmail": "admin@salesapp.local",
    "AdminFullName": "System Administrator"
  },
  "Business": {
    "TimeZone": "Asia/Kolkata"
  },
  "Inventory": {
    "AllowNegativeStock": false
  },
  "Ai": {
    "//": "The Claude API key is NOT set here: use user-secrets (Anthropic:ApiKey) or the Anthropic__ApiKey environment variable. Pricing is US dollars per million tokens, for cost estimates; cache writes are the 5-minute rate (1.25x input).",
    "Enabled": true,
    "DailyBudgetUsdPerUser": 2.0,
    "RequestsPerMinutePerUser": 10,
    "UsdToInr": 88.0,
    "Features": {
      "OrderEntry": { "Model": "claude-opus-5-5", "Effort": "medium", "MaxTokens": 8000 },
      "AskData": { "Model": "claude-opus-5-5", "Effort": "medium", "MaxTokens": 8000 }
    },
    "AskData": { "MaxQueries": 5 },
    "Pricing": {
      "claude-opus-5-5": { "Input": 4.0, "Output": 20.0, "CacheRead": 0.20, "CacheWrite": 5.0 },
      "claude-sonnet-5-5": { "Input": 2.0, "Output": 10.0, "CacheRead": 0.20, "CacheWrite": 2.5 },
      "claude-haiku-5-5": { "Input": 0.10, "Output": 0.50, "CacheRead": 0.01, "CacheWrite": 0.125 }
    }
  }
}
