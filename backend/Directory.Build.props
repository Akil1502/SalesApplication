<Project>
  <!-- Shared settings for every project in the backend. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- XML docs feed the OpenAPI document; CS1591 (missing docs) is noise for internal members. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CA1848/CA1873 push every log call into source-generated LoggerMessage delegates. That pays off
      on hot paths in high-throughput services, not in a line-of-business app, so we log normally.
    -->
    <NoWarn>$(NoWarn);CS1591;CA1848;CA1873</NoWarn>
  </PropertyGroup>
</Project>
