<Project>
  <!-- Central package management: every version is pinned here, projects reference packages without versions. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Versions pinned below also apply to packages pulled in indirectly, so a security fix reaches every project. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Data and identity">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Reporting">
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>
  <ItemGroup Label="AI">
    <!-- Official Anthropic SDK for the Claude API. -->
    <PackageVersion Include="Anthropic" Version="12.51.0" />
    <!-- Microsoft's T-SQL parser: checks AI-written SQL structurally rather than with regexes. -->
    <PackageVersion Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.117.0" />
  </ItemGroup>
  <ItemGroup Label="Security pins">
    <!-- Via EF Core > Microsoft.Data.SqlClient 6.1.6, which brings 9.0.11 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). 10.0.13 is the first fixed release. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>
</Project>
